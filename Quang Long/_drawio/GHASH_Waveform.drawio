        <mxCell id="notes_left" value="&lt;b&gt;Input blocks&lt;/b&gt;&lt;br&gt;H = AES&lt;sub&gt;K&lt;/sub&gt;(0¹²⁸) = 128'h66e94bd4ef8a2c3b884cfa59ca342b2e&lt;br&gt;C₁ = 128'h0388dace60b6a392f328c2b971b2fe78&lt;br&gt;LEN = len(A) || len(C) = 128'h00000000000000000000000000000080" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="notes"><mxGeometry x="20" y="40" width="650" height="120" as="geometry" /></mxCell>
        <mxCell id="notes_right" value="&lt;b&gt;Expected GHASH states&lt;/b&gt;&lt;br&gt;X₁ = C₁ · H = 128'h5e2ec746917062882c85b0685353deb7&lt;br&gt;X₂ = (X₁ ⊕ LEN) · H = 128'hf38cbb1ad69223dcc3457ae5b6b0f885&lt;br&gt;&lt;b&gt;Timing assumption:&lt;/b&gt; 1 block/cycle while ghash_en=1; load initializes X₀=0; ghash_finish pulses after the final block. RTL latency/FSM is not yet defined in the current GHASH.sv skeleton." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="notes"><mxGeometry x="690" y="40" width="650" height="130" as="geometry" /></mxCell>
